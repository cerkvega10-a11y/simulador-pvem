# =========================================================================
# GOVTECH WAR ROOM — CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL REAL Y SEGURIDAD
# =========================================================================

# 1. GOOGLE GEMINI (Recomendado - Gratuito en Google AI Studio)
# Obtén tu clave en: https://aistudio.google.com/app/apikey (Inicia con AIzaSy...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Clave secundaria de respaldo (opcional para tolerancia a fallos)
BACKUP_API_KEY=

# 2. GROQ CLOUD (Alternativa Gratuita Ultra-Rápida con Llama 3.3 70B)
# Obtén tu clave gratuita en: https://console.groq.com/keys (Inicia con gsk_...)
GROQ_API_KEY=

# 3. SEGURIDAD Y CIFRADO
# Clave para cifrado AES-256 de claves de clientes en licensesStore.json
ENCRYPTION_KEY=clave_secreta_aes256_super_segura_de_al_menos_32_caracteres_2027

# Secreto para firma de tokens de sesión
SESSION_SECRET=secreto_para_sesiones_govtech_war_room_2027

# 4. PUERTO DEL SERVIDOR
PORT=3000
